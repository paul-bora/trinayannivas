// Cloudflare Workers deployment: serves the built app from dist/ as static files.
// Having this file stops Cloudflare from trying to auto-configure the Vite project.
{
  "name": "trinayannivas",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
